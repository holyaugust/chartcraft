# Sidecar 监听
PPT_MASTER_API_HOST=0.0.0.0
PPT_MASTER_API_PORT=8787

# hugohe3/ppt-master 克隆路径（Docker 内默认 /opt/ppt-master）
PPT_MASTER_HOME=/opt/ppt-master

# 规划 LLM — 任选其一：
#
# 七牛云 AI 大模型推理（OpenAI 兼容，Claude/GPT 等）：
PPT_MASTER_LLM_API_URL=https://api.qnaigc.com/v1/chat/completions
PPT_MASTER_LLM_API_KEY=你的七牛云API_KEY
PPT_MASTER_LLM_MODEL=claude-sonnet-4-6
#
# OpenRouter：
# PPT_MASTER_LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# PPT_MASTER_LLM_API_KEY=sk-or-your-key
# PPT_MASTER_LLM_MODEL=anthropic/claude-sonnet-4
#
# Anthropic 官方：
# PPT_MASTER_LLM_API_URL=https://api.anthropic.com/v1/messages
# PPT_MASTER_LLM_API_KEY=sk-ant-your-key
# PPT_MASTER_LLM_MODEL=claude-sonnet-4-20250514
#
# DeepSeek（仅规划，视觉需另配）：
# PPT_MASTER_LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# PPT_MASTER_LLM_API_KEY=sk-your-key
# PPT_MASTER_LLM_MODEL=deepseek-chat
PPT_MASTER_LLM_TIMEOUT=300

# 渲染模式：ai_svg（默认，AI 逐页 SVG，高视觉）| template（内置模板，快速）
PPT_MASTER_RENDER_MODE=ai_svg

# Executor 逐页 SVG（留空则沿用规划 LLM）
# 规划 + Strategist 走 PPT_MASTER_LLM_*；仅 Executor 走下方端点
#
# 阿里百炼官方 qwen-max（OpenAI 兼容）：
# PPT_MASTER_EXECUTOR_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# PPT_MASTER_EXECUTOR_API_KEY=sk-你的百炼Key
# PPT_MASTER_EXECUTOR_MODEL=qwen-max
#
# 旧变量名仍兼容：PPT_MASTER_VISUAL_*

# 任务数据目录
PPT_MASTER_DATA_DIR=./data
