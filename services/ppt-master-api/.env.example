# Sidecar 监听
PPT_MASTER_API_HOST=0.0.0.0
PPT_MASTER_API_PORT=8787

# hugohe3/ppt-master 克隆路径（Docker 内默认 /opt/ppt-master）
PPT_MASTER_HOME=/opt/ppt-master

# 规划 LLM — 任选其一：
#
# 七牛云 AI 大模型推理（OpenAI 兼容，Claude/GPT 等）：
PPT_MASTER_LLM_API_URL=https://api.qnaigc.com/v1/chat/completions
PPT_MASTER_LLM_API_KEY=你的七牛云API_KEY
PPT_MASTER_LLM_MODEL=claude-sonnet-4-6
#
# OpenRouter：
# PPT_MASTER_LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# PPT_MASTER_LLM_API_KEY=sk-or-your-key
# PPT_MASTER_LLM_MODEL=anthropic/claude-sonnet-4
#
# Anthropic 官方：
# PPT_MASTER_LLM_API_URL=https://api.anthropic.com/v1/messages
# PPT_MASTER_LLM_API_KEY=sk-ant-your-key
# PPT_MASTER_LLM_MODEL=claude-sonnet-4-20250514
#
# DeepSeek（仅规划，视觉需另配）：
# PPT_MASTER_LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# PPT_MASTER_LLM_API_KEY=sk-your-key
# PPT_MASTER_LLM_MODEL=deepseek-chat
#
# DeepSeek 视觉版（截图还原 / 参考图分析，需支持 image_url 的多模态模型）：
# PPT_MASTER_VISION_ENABLED=true
# PPT_MASTER_VISION_MODEL=deepseek-v4-flash
# PPT_MASTER_VISION_API_URL=   ← 留空则沿用 PPT_MASTER_LLM_API_URL（DeepSeek 官方不支持读图）
# PPT_MASTER_VISION_API_KEY=   ← 留空则沿用 PPT_MASTER_LLM_API_KEY
#
# 若仅有千帆文库 PPT Key（/v2/tools/ai_ppt），不能用于视觉对话；请单独配置百炼等视觉端点，例如：
# PPT_MASTER_VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# PPT_MASTER_VISION_API_KEY=sk-你的百炼Key
# PPT_MASTER_VISION_MODEL=qwen-vl-plus
#
# 视觉模型不可用时，默认用截图铺底降级（版式一致，文字需在 PPT 中再编辑）：
# PPT_MASTER_REPLICA_IMAGE_FALLBACK=true
PPT_MASTER_LLM_TIMEOUT=300

# 渲染模式：ai_svg（默认，AI 逐页 SVG，高视觉）| template（内置模板，快速）
PPT_MASTER_RENDER_MODE=ai_svg

# Executor 逐页 SVG（端点/Key 可单独配置；模型名固定为 PPT_MASTER_VISION_MODEL，默认 deepseek-v4-flash）
#
# 阿里百炼官方 qwen-max（OpenAI 兼容）— 仅改端点/Key，模型仍走 VISION_MODEL：
# PPT_MASTER_EXECUTOR_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# PPT_MASTER_EXECUTOR_API_KEY=sk-你的百炼Key
#
# 旧变量名仍兼容：PPT_MASTER_VISUAL_*、PPT_MASTER_EXECUTOR_MODEL（模型名以 VISION_MODEL 为准）

# 任务数据目录
PPT_MASTER_DATA_DIR=./data

# —— 千帆 · 百度文库智能 PPT（可选，启用「千帆 PPT」Tab）——
# 在千帆控制台创建 API Key：https://console.bce.baidu.com/qianfan/ais/console/applicationConsole/application
QIANFAN_API_KEY=
# QIANFAN_API_BASE=https://qianfan.baidubce.com
# QIANFAN_REQUEST_TIMEOUT=900
